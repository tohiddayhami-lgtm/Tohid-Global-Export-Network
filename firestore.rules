rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{document} {
      // Anyone can read site content and network data (public website)
      allow read: if true;
      // Only authenticated admins can write
      allow write: if request.auth != null;
    }

    match /contact_messages/{messageId} {
      // Anyone can submit a contact form message
      allow create: if true;
      // Only authenticated admins can read or delete messages
      allow read, delete: if request.auth != null;
      // Nobody can update (messages are immutable once submitted)
      allow update: if false;
    }
  }
}
