# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web — required for /admin sign-in and cloud data (https://console.firebase.google.com)
#
# 1) Project settings → Your apps → Web app → copy the config into the variables below.
# 2) Authentication → Sign-in method → enable Email/Password → create an admin user under Users.
# 3) Firestore: create a database; allow authenticated writes to config/export_network (see Firebase docs / rules).
#
# Vite only exposes env vars prefixed with VITE_. After editing .env, run: npm run build
#
# Subpath deploy only (e.g. https://user.github.io/REPO_NAME/): set trailing slash
# VITE_BASE_PATH=/REPO_NAME/

# Runtime Firebase: `public/firebase-config.json` is copied into `dist/` so production works even when CI has no .env.
# Copy from firebase-config.json.example if you prefer not to commit config (then use hosting env vars at build time).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
